  </worldbody>
  <actuator>
    <general name="BLDC1" site="prop1_site" gear="0 0 1 0 0  0.02" ctrlrange="0 18" />
    <general name="BLDC2" site="prop2_site" gear="0 0 1 0 0 -0.02" ctrlrange="0 18" />
    <general name="BLDC3" site="prop3_site" gear="0 0 1 0 0  0.02" ctrlrange="0 18"/>
    <general name="BLDC4" site="prop4_site" gear="0 0 1 0 0 -0.02" ctrlrange="0 18"/>
    <position name="servo1_pos" joint="j_servo1" kp="10" kv="0.2" ctrlrange="-1.57079632679 1.57079632679" />
    <position name="servo2_pos" joint="j_servo2" kp="10" kv="0.2" ctrlrange="-1.57079632679 1.57079632679" />
    <position name="servo3_pos" joint="j_servo3" kp="10" kv="0.2" ctrlrange="-1.57079632679 1.57079632679" />
    <position name="servo4_pos" joint="j_servo4" kp="10" kv="0.2" ctrlrange="-1.57079632679 1.57079632679" />
  </actuator>
  <sensor>
    <!-- Contact-plate corner force sensors: (+y,+z), (-y,+z), (-y,-z), (+y,-z). -->
    <touch name="cop_force_pp" site="cop_sensor_pp" />
    <touch name="cop_force_np" site="cop_sensor_np" />
    <touch name="cop_force_nn" site="cop_sensor_nn" />
    <touch name="cop_force_pn" site="cop_sensor_pn" />
    <!-- IMU site: drone_imu -->
    <framequat name="body_quat" objtype="site" objname="drone_imu" />
    <gyro name="body_gyro" site="drone_imu" />
    <!-- Base body: drone_base -->
    <framepos name="base_pos" objtype="body" objname="drone_base" />
    <framelinvel name="base_linvel" objtype="body" objname="drone_base" />
    <!-- Servo sensors -->
    <jointpos name="servo1_angle" joint="j_servo1" />
    <jointpos name="servo2_angle" joint="j_servo2" />
    <jointpos name="servo3_angle" joint="j_servo3" />
    <jointpos name="servo4_angle" joint="j_servo4" />
    <jointvel name="servo1_vel" joint="j_servo1" />
    <jointvel name="servo2_vel" joint="j_servo2" />
    <jointvel name="servo3_vel" joint="j_servo3" />
    <jointvel name="servo4_vel" joint="j_servo4" />
    <!-- Propeller site states -->
